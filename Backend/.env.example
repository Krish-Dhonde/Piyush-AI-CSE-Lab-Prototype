# ===================================================================
# Virtual CSE Lab - Backend Environment Configuration Template
# NOTE: This file contains safe placeholders only.
# Copy this file to .env and adjust values for your environment.
# Never commit real credentials, secrets, or production URIs.
# ===================================================================

# Application Environment (development | production | test)
NODE_ENV=development

# Server Binding
PORT=5000
HOST=127.0.0.1

# Database Configuration
# In production, use authenticated URI with replica set.
MONGODB_URI=mongodb://127.0.0.1:27017/virtual_cse_lab

# CORS Configuration (comma-separated list of allowed origins or single origin)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate Limiting
# RATE_LIMIT_WINDOW_MS in milliseconds (e.g. 900000 for 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per IP per window
RATE_LIMIT_MAX=100

# Structured Logging Level (fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=info
